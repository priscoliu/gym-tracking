{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "padding": 0,
  "autosize": {"type": "pad", "resize": true},
  "signals": [
    {"name": "rowHeight",      "value": 68},
    {"name": "headerHeight",   "value": 90},
    {"name": "clientColWidth", "value": 280},
    {"name": "revColWidth",    "value": 65},
    {"name": "cntColWidth",    "value": 44},
    {"name": "classColWidth",  "value": 56},
    {"name": "bodyHeight",  "update": "length(data('clients')) * rowHeight"},
    {"name": "chartHeight", "update": "bodyHeight + headerHeight"},
    {"name": "matrixWidth", "update": "length(data('classes')) * classColWidth"},
    {"name": "totalWidth",  "update": "clientColWidth + revColWidth + cntColWidth + matrixWidth"}
  ],
  "width":  {"signal": "totalWidth"},
  "height": {"signal": "chartHeight"},

  "data": [
    {
      "name": "dataset",
      "transform": [
        {
          "type": "formula",
          "expr": "datum.Tier == 'Tier 1' ? 1 : datum.Tier == 'Tier 2' ? 2 : datum.Tier == 'Tier 3' ? 3 : datum.Tier == 'Tier 4' ? 4 : 5",
          "as": "tierOrd"
        }
      ]
    },
    {
      "name": "clients",
      "source": "dataset",
      "transform": [
        {
          "type": "aggregate",
          "groupby": ["ClientName", "ClientId", "Industry", "Tier", "tierOrd"],
          "fields": ["Revenue", "ProductClass"],
          "ops":    ["sum",     "distinct"],
          "as":     ["TotalRev","ClassCount"]
        },
        {"type": "collect", "sort": {"field": "TotalRev", "order": "descending"}}
      ]
    },
    {
      "name": "classes",
      "source": "dataset",
      "transform": [
        {
          "type": "aggregate",
          "groupby": ["ProductClass"],
          "fields": ["ClientName"],
          "ops":    ["distinct"],
          "as":     ["holdCount"]
        },
        {"type": "collect", "sort": {"field": "holdCount", "order": "descending"}}
      ]
    },
    {
      "name": "cells",
      "source": "dataset",
      "transform": [
        {"type": "aggregate", "groupby": ["ClientName", "ProductClass"]},
        {
          "type": "formula",
          "expr": "datum.ClientName + '||' + datum.ProductClass",
          "as": "cellKey"
        }
      ]
    },
    {
      "name": "allCombos",
      "source": "clients",
      "transform": [
        {"type": "cross", "with": "classes"},
        {
          "type": "formula",
          "expr": "datum.a.ClientName + '||' + datum.b.ProductClass",
          "as": "cellKey"
        },
        {
          "type": "lookup",
          "from": "cells",
          "key": "cellKey",
          "fields": ["cellKey"],
          "values": ["cellKey"],
          "as": ["matched"],
          "default": null
        },
        {
          "type": "formula",
          "expr": "datum.matched != null ? 1 : 0",
          "as": "hasClass"
        }
      ]
    },
    {
      "name": "adoption",
      "source": "allCombos",
      "transform": [
        {"type": "formula", "expr": "datum.b.ProductClass", "as": "ProductClass"},
        {
          "type": "aggregate",
          "groupby": ["ProductClass"],
          "fields": ["hasClass"],
          "ops":    ["sum"],
          "as":     ["holdCount"]
        },
        {
          "type": "formula",
          "expr": "datum.holdCount / length(data('clients'))",
          "as": "adoptionPct"
        }
      ]
    },
    {
      "name": "shadowLines",
      "values": [
        {"offset": 0, "opacity": 1,     "color": "#E5E7EB"},
        {"offset": 1, "opacity": 0.14,  "color": "#000000"},
        {"offset": 2, "opacity": 0.09,  "color": "#000000"},
        {"offset": 3, "opacity": 0.05,  "color": "#000000"},
        {"offset": 4, "opacity": 0.025, "color": "#000000"}
      ]
    }
  ],

  "scales": [
    {
      "name": "y",
      "type": "band",
      "domain": {"data": "clients", "field": "ClientName", "sort": false},
      "range": [{"signal": "headerHeight"}, {"signal": "chartHeight"}],
      "paddingInner": 0,
      "paddingOuter": 0
    },
    {
      "name": "xClass",
      "type": "band",
      "domain": {"data": "classes", "field": "ProductClass", "sort": false},
      "range": [0, {"signal": "matrixWidth"}],
      "paddingInner": 0,
      "paddingOuter": 0
    }
  ],

  "marks": [

    {
      "type": "group",
      "name": "panelClient",
      "encode": {
        "update": {
          "x": {"value": 0},
          "y": {"value": 0},
          "width":  {"signal": "clientColWidth"},
          "height": {"signal": "chartHeight"}
        }
      },
      "marks": [
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {"value": 14}, "y": {"value": 10},
              "text": {"value": "Penetration Matrix"},
              "align": {"value": "left"}, "baseline": {"value": "top"},
              "fontSize": {"value": 14}, "fontWeight": {"value": 700},
              "fill": {"value": "#181B1D"}
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {"value": 14}, "y": {"value": 28},
              "text": {"value": "✓ = client holds this class  ·  blank = whitespace"},
              "align": {"value": "left"}, "baseline": {"value": "top"},
              "fontSize": {"value": 9}, "fill": {"value": "#9CA3AF"}
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {"value": 14}, "y": {"value": 52},
              "text": {"value": "Client"},
              "align": {"value": "left"}, "baseline": {"value": "middle"},
              "fontSize": {"value": 10}, "fontWeight": {"value": 600},
              "fill": {"value": "#6B7280"}
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {"value": 14}, "y": {"value": 78},
              "text": {"value": "Adoption %"},
              "align": {"value": "left"}, "baseline": {"value": "middle"},
              "fontSize": {"value": 9}, "fill": {"value": "#9CA3AF"}
            }
          }
        },
        {
          "type": "rule",
          "from": {"data": "clients"},
          "encode": {
            "update": {
              "x": {"value": 0}, "x2": {"signal": "clientColWidth"},
              "y": {"scale": "y", "field": "ClientName", "band": 1},
              "stroke": {"value": "#E5E7EB"}
            }
          }
        },
        {
          "type": "text",
          "from": {"data": "clients"},
          "encode": {
            "update": {
              "x": {"value": 14},
              "y": {"scale": "y", "field": "ClientName", "offset": 17},
              "text": {"field": "ClientName"},
              "align": {"value": "left"}, "baseline": {"value": "top"},
              "fontSize": {"value": 11}, "fontWeight": {"value": 700},
              "fill": {"value": "#1E293B"}, "limit": {"value": 252}
            }
          }
        },
        {
          "type": "text",
          "from": {"data": "clients"},
          "encode": {
            "update": {
              "x": {"value": 14},
              "y": {"scale": "y", "field": "ClientName", "offset": 35},
              "text": {"signal": "datum.ClientId + ' · ' + datum.Tier"},
              "align": {"value": "left"}, "baseline": {"value": "top"},
              "fontSize": {"value": 9}, "fill": {"value": "#9CA3AF"},
              "limit": {"value": 252}
            }
          }
        },
        {
          "type": "text",
          "from": {"data": "clients"},
          "encode": {
            "update": {
              "x": {"value": 14},
              "y": {"scale": "y", "field": "ClientName", "offset": 50},
              "text": {"field": "Industry"},
              "align": {"value": "left"}, "baseline": {"value": "top"},
              "fontSize": {"value": 9}, "fill": {"value": "#9CA3AF"},
              "limit": {"value": 252}
            }
          }
        }
      ]
    },

    {
      "type": "group",
      "name": "panelRev",
      "encode": {
        "update": {
          "x": {"signal": "clientColWidth"},
          "y": {"value": 0},
          "width":  {"signal": "revColWidth"},
          "height": {"signal": "chartHeight"}
        }
      },
      "marks": [
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {"signal": "revColWidth - 8"}, "y": {"value": 52},
              "text": {"value": "Rev."},
              "align": {"value": "right"}, "baseline": {"value": "middle"},
              "fontSize": {"value": 10}, "fontWeight": {"value": 600},
              "fill": {"value": "#6B7280"}
            }
          }
        },
        {
          "type": "rule",
          "from": {"data": "clients"},
          "encode": {
            "update": {
              "x": {"value": 0}, "x2": {"signal": "revColWidth"},
              "y": {"scale": "y", "field": "ClientName", "band": 1},
              "stroke": {"value": "#E5E7EB"}
            }
          }
        },
        {
          "type": "text",
          "from": {"data": "clients"},
          "encode": {
            "update": {
              "x": {"signal": "revColWidth - 8"},
              "y": {"scale": "y", "field": "ClientName", "band": 0.5},
              "text": {
                "signal": "datum.TotalRev >= 1000000 ? '$' + format(datum.TotalRev/1000000, '.1f') + 'M' : datum.TotalRev >= 1000 ? '$' + format(datum.TotalRev/1000, '.0f') + 'K' : '$' + format(datum.TotalRev, ',')"
              },
              "align": {"value": "right"}, "baseline": {"value": "middle"},
              "fontSize": {"value": 10}, "fontWeight": {"value": 600},
              "fill": {"value": "#374151"}
            }
          }
        },
        {
          "type": "rule",
          "encode": {
            "update": {
              "x": {"signal": "revColWidth"}, "y": {"value": 0},
              "y2": {"signal": "chartHeight"},
              "stroke": {"value": "#E5E7EB"}
            }
          }
        }
      ]
    },

    {
      "type": "group",
      "name": "panelCount",
      "encode": {
        "update": {
          "x": {"signal": "clientColWidth + revColWidth"},
          "y": {"value": 0},
          "width":  {"signal": "cntColWidth"},
          "height": {"signal": "chartHeight"}
        }
      },
      "marks": [
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {"signal": "cntColWidth / 2"}, "y": {"value": 52},
              "text": {"value": "#"},
              "align": {"value": "center"}, "baseline": {"value": "middle"},
              "fontSize": {"value": 10}, "fontWeight": {"value": 600},
              "fill": {"value": "#6B7280"}
            }
          }
        },
        {
          "type": "rule",
          "from": {"data": "clients"},
          "encode": {
            "update": {
              "x": {"value": 0}, "x2": {"signal": "cntColWidth"},
              "y": {"scale": "y", "field": "ClientName", "band": 1},
              "stroke": {"value": "#E5E7EB"}
            }
          }
        },
        {
          "type": "text",
          "from": {"data": "clients"},
          "encode": {
            "update": {
              "x": {"signal": "cntColWidth / 2"},
              "y": {"scale": "y", "field": "ClientName", "band": 0.5},
              "text": {"signal": "format(datum.ClassCount, 'd')"},
              "align": {"value": "center"}, "baseline": {"value": "middle"},
              "fontSize": {"value": 15}, "fontWeight": {"value": 700},
              "fill": [
                {"test": "datum.ClassCount >= 4", "value": "#059669"},
                {"test": "datum.ClassCount == 3", "value": "#7F35B2"},
                {"test": "datum.ClassCount == 2", "value": "#C084FC"},
                {"value": "#DC2626"}
              ]
            }
          }
        },
        {
          "type": "rule",
          "encode": {
            "update": {
              "x": {"signal": "cntColWidth"}, "y": {"value": 0},
              "y2": {"signal": "chartHeight"},
              "stroke": {"value": "#E5E7EB"}
            }
          }
        }
      ]
    },

    {
      "type": "group",
      "name": "panelMatrix",
      "encode": {
        "update": {
          "x": {"signal": "clientColWidth + revColWidth + cntColWidth"},
          "y": {"value": 0},
          "width":  {"signal": "matrixWidth"},
          "height": {"signal": "chartHeight"}
        }
      },
      "marks": [
        {
          "type": "text",
          "from": {"data": "classes"},
          "encode": {
            "update": {
              "x": {"scale": "xClass", "field": "ProductClass", "band": 0.5},
              "y": {"value": 82},
              "text": {"field": "ProductClass"},
              "angle": {"value": -90},
              "align": {"value": "left"},
              "baseline": {"value": "middle"},
              "fontSize": {"value": 10}, "fontWeight": {"value": 600},
              "fill": {"value": "#6B7280"},
              "limit": {"value": 48}
            }
          }
        },
        {
          "type": "text",
          "from": {"data": "adoption"},
          "encode": {
            "update": {
              "x": {"scale": "xClass", "field": "ProductClass", "band": 0.5},
              "y": {"value": 83},
              "text": {"signal": "format(datum.adoptionPct, '.0%')"},
              "align": {"value": "center"}, "baseline": {"value": "top"},
              "fontSize": {"value": 9}, "fill": {"value": "#9CA3AF"}
            }
          }
        },
        {
          "type": "rule",
          "from": {"data": "clients"},
          "encode": {
            "update": {
              "x": {"value": 0}, "x2": {"signal": "matrixWidth"},
              "y": {"scale": "y", "field": "ClientName", "band": 1},
              "stroke": {"value": "#E5E7EB"}
            }
          }
        },
        {
          "type": "rule",
          "from": {"data": "classes"},
          "encode": {
            "update": {
              "y": {"signal": "headerHeight"}, "y2": {"signal": "chartHeight"},
              "x": {"scale": "xClass", "field": "ProductClass", "band": 1},
              "stroke": {"value": "#F3F4F6"}
            }
          }
        },
        {
          "type": "rect",
          "from": {"data": "allCombos"},
          "encode": {
            "update": {
              "x":  {"scale": "xClass", "field": "b.ProductClass", "offset": 8},
              "x2": {"scale": "xClass", "field": "b.ProductClass", "band": 1, "offset": -8},
              "y":  {"scale": "y", "field": "a.ClientName", "offset": 14},
              "y2": {"scale": "y", "field": "a.ClientName", "band": 1, "offset": -14},
              "cornerRadius": {"value": 8},
              "fill": [
                {"test": "datum.hasClass == 1", "value": "#EDE9FE"},
                {"value": "#F9FAFB"}
              ],
              "stroke": [
                {"test": "datum.hasClass == 1", "value": "#C4B5FD"},
                {"value": "#EAEBEC"}
              ],
              "strokeWidth": {"value": 1}
            }
          }
        },
        {
          "type": "text",
          "from": {"data": "allCombos"},
          "encode": {
            "update": {
              "x": {"scale": "xClass", "field": "b.ProductClass", "band": 0.5},
              "y": {"scale": "y", "field": "a.ClientName", "band": 0.5},
              "text": [
                {"test": "datum.hasClass == 1", "value": "✓"},
                {"value": ""}
              ],
              "align": {"value": "center"}, "baseline": {"value": "middle"},
              "fontSize": {"value": 13}, "fontWeight": {"value": 700},
              "fill": {"value": "#7F35B2"}
            }
          }
        }
      ]
    },

    {
      "type": "group",
      "name": "legend",
      "encode": {
        "update": {
          "x": {"signal": "totalWidth - 215"},
          "y": {"value": 8},
          "width":  {"value": 215},
          "height": {"value": 20}
        }
      },
      "marks": [
        {
          "type": "rect",
          "encode": {
            "update": {
              "x": {"value": 0}, "y": {"value": 1},
              "width": {"value": 26}, "height": {"value": 18},
              "cornerRadius": {"value": 5},
              "fill": {"value": "#EDE9FE"},
              "stroke": {"value": "#C4B5FD"}, "strokeWidth": {"value": 1}
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {"value": 13}, "y": {"value": 10},
              "text": {"value": "✓"},
              "align": {"value": "center"}, "baseline": {"value": "middle"},
              "fontSize": {"value": 11}, "fontWeight": {"value": 700},
              "fill": {"value": "#7F35B2"}
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {"value": 32}, "y": {"value": 10},
              "text": {"value": "Has class"},
              "baseline": {"value": "middle"},
              "fontSize": {"value": 10}, "fill": {"value": "#374151"}
            }
          }
        },
        {
          "type": "rect",
          "encode": {
            "update": {
              "x": {"value": 105}, "y": {"value": 1},
              "width": {"value": 26}, "height": {"value": 18},
              "cornerRadius": {"value": 5},
              "fill": {"value": "#F9FAFB"},
              "stroke": {"value": "#EAEBEC"}, "strokeWidth": {"value": 1}
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {"value": 137}, "y": {"value": 10},
              "text": {"value": "Whitespace"},
              "baseline": {"value": "middle"},
              "fontSize": {"value": 10}, "fill": {"value": "#374151"}
            }
          }
        }
      ]
    },

    {
      "type": "group",
      "name": "headerShadow",
      "encode": {
        "update": {
          "x": {"value": 0}, "y": {"value": 0},
          "width":  {"signal": "totalWidth"},
          "height": {"signal": "headerHeight + 6"}
        }
      },
      "marks": [
        {
          "type": "rule",
          "from": {"data": "shadowLines"},
          "encode": {
            "update": {
              "x": {"value": 0}, "x2": {"signal": "totalWidth"},
              "y": {"signal": "headerHeight + datum.offset"},
              "stroke": {"field": "color"},
              "strokeOpacity": {"field": "opacity"},
              "strokeWidth": {"value": 1}
            }
          }
        }
      ]
    }

  ]
}
