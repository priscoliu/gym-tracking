-- Table:  Core Metrics
-- Folder: SME Delivery\Tasks
-- Calculated status VH: Critical AND Delayed
-- Matches gantt-polished.html statusStyles.VH (#ffbfc1 / #7A181C)
Delivery Status VH Count =
CALCULATE(
    COUNTROWS(fact_project_tasks),
    fact_project_tasks[IsCritical] = TRUE,
    fact_project_tasks[IsDelayed]  = TRUE
)
