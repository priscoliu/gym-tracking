-- Table:  Core Metrics
-- Folder: SME Delivery\Tasks
-- Calculated status H: Critical only (not delayed)
-- Matches gantt-polished.html statusStyles.H (#f8cbad / #843515)
Delivery Status H Count =
CALCULATE(
    COUNTROWS(fact_project_tasks),
    fact_project_tasks[IsCritical] = TRUE,
    fact_project_tasks[IsDelayed]  = FALSE
)
