-- Table:  Core Metrics
-- Folder: SME Delivery\Tasks
-- Calculated status L: Neither critical nor delayed
-- Matches gantt-polished.html statusStyles.L (#c6efce / #1E6024)
Delivery Status L Count =
CALCULATE(
    COUNTROWS(fact_project_tasks),
    fact_project_tasks[IsCritical] = FALSE,
    fact_project_tasks[IsDelayed]  = FALSE
)
