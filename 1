kpiExecutiveCard = 
VAR _current = [New Biz Actual]
VAR _benchmark = [MR New Business Plan2]
VAR _forecast = [Total Projected Revenue]
VAR _ProjectedRevenue =
    CALCULATE(
        [Projected Revenue],
        'fact_new_business_pipeline'[c.Inception Date] > TODAY() - 1
    )
VAR _ForecastedNewBizWon =
    CALCULATE(
        [Forecasted New Biz Won],
        'fact_new_business_pipeline'[c.Inception Date] > TODAY() - 1
    )
VAR _selectedYear = FORMAT(MAX(rDate[Year]), "0")
VAR _totalBudgetYear = CALCULATE(
    [MR New Business Plan2],
    REMOVEFILTERS(rDate[Quarter]),
    REMOVEFILTERS(rDate[Month]),
    REMOVEFILTERS(rDate[MonthNo.]),
    REMOVEFILTERS(rDate[rQuarter]),
    REMOVEFILTERS(rDate[rMonth])
)

-- Total Pipeline (Open + Won)
VAR _totalPipeline = _ProjectedRevenue + _ForecastedNewBizWon

-- Check if we have data
VAR _hasTarget = _benchmark > 0
VAR _hasActual = _current > 0

-- Performance calculations
VAR _effectiveCurrent = _current + _forecast
VAR _achievementRatio = DIVIDE(_effectiveCurrent, _benchmark)

-- Bar Width Calculation
VAR _currentBarWidth = MAX(0, DIVIDE(_effectiveCurrent, _benchmark))
VAR _benchmarkBarWidth = 1.0

-- Widths for progress bar
VAR _currentWidthCSS = FORMAT(
    MIN(IF(_currentBarWidth > 1, 1, _currentBarWidth), 1) * 100,
    "0.0"
) & "%"
VAR _benchmarkWidthCSS = "100%"

-- Number Formatting
VAR _displayCurrent = 
    IF(_current < 0, "-", "") & "$" &
    SWITCH(
        TRUE(),
        ABS(_current) >= 1000000000, FORMAT(ABS(_current) / 1000000000, "0.0") & "B",
        ABS(_current) >= 1000000, FORMAT(ABS(_current) / 1000000, "0.0") & "M",
        ABS(_current) >= 1000, FORMAT(ABS(_current) / 1000, "0.0") & "K",
        FORMAT(ABS(_current), "#,##0")
    )

VAR _displayBenchmark = "$" &
    SWITCH(
        TRUE(),
        ABS(_benchmark) >= 1000000000, FORMAT(ABS(_benchmark) / 1000000000, "0.0") & "B",
        ABS(_benchmark) >= 1000000, FORMAT(ABS(_benchmark) / 1000000, "0.0") & "M",
        ABS(_benchmark) >= 1000, FORMAT(ABS(_benchmark) / 1000, "0.0") & "K",
        FORMAT(ABS(_benchmark), "#,##0")
    )

VAR _displayTotalBudgetYear = "$" &
    SWITCH(
        TRUE(),
        ABS(_totalBudgetYear) >= 1000000000, FORMAT(ABS(_totalBudgetYear) / 1000000000, "0.0") & "B",
        ABS(_totalBudgetYear) >= 1000000, FORMAT(ABS(_totalBudgetYear) / 1000000, "0.0") & "M",
        ABS(_totalBudgetYear) >= 1000, FORMAT(ABS(_totalBudgetYear) / 1000, "0.0") & "K",
        FORMAT(ABS(_totalBudgetYear), "#,##0")
    )

VAR _displayTotalPipeline = "$" &
    SWITCH(
        TRUE(),
        ABS(_totalPipeline) >= 1000000000, FORMAT(ABS(_totalPipeline) / 1000000000, "0.0") & "B",
        ABS(_totalPipeline) >= 1000000, FORMAT(ABS(_totalPipeline) / 1000000, "0.0") & "M",
        ABS(_totalPipeline) >= 1000, FORMAT(ABS(_totalPipeline) / 1000, "0.0") & "K",
        FORMAT(ABS(_totalPipeline), "#,##0")
    )

VAR _displayForecast = "$" &
    SWITCH(
        TRUE(),
        ABS(_forecast) >= 1000000000, FORMAT(ABS(_forecast) / 1000000000, "0.0") & "B",
        ABS(_forecast) >= 1000000, FORMAT(ABS(_forecast) / 1000000, "0.0") & "M",
        ABS(_forecast) >= 1000, FORMAT(ABS(_forecast) / 1000, "0.0") & "K",
        FORMAT(ABS(_forecast), "#,##0")
    )

VAR _displayWtOpen = "$" &
    SWITCH(
        TRUE(),
        ABS(_ProjectedRevenue) >= 1000000000, FORMAT(ABS(_ProjectedRevenue) / 1000000000, "0.0") & "B",
        ABS(_ProjectedRevenue) >= 1000000, FORMAT(ABS(_ProjectedRevenue) / 1000000, "0.0") & "M",
        ABS(_ProjectedRevenue) >= 1000, FORMAT(ABS(_ProjectedRevenue) / 1000, "0.0") & "K",
        FORMAT(ABS(_ProjectedRevenue), "#,##0")
    )

VAR _displayCrmWon = "$" &
    SWITCH(
        TRUE(),
        ABS(_ForecastedNewBizWon) >= 1000000000, FORMAT(ABS(_ForecastedNewBizWon) / 1000000000, "0.0") & "B",
        ABS(_ForecastedNewBizWon) >= 1000000, FORMAT(ABS(_ForecastedNewBizWon) / 1000000, "0.0") & "M",
        ABS(_ForecastedNewBizWon) >= 1000, FORMAT(ABS(_ForecastedNewBizWon) / 1000, "0.0") & "K",
        FORMAT(ABS(_ForecastedNewBizWon), "#,##0")
    )

VAR _displayEffectiveCurrent = 
    IF(_effectiveCurrent < 0, "-", "") & "$" &
    SWITCH(
        TRUE(),
        ABS(_effectiveCurrent) >= 1000000000, FORMAT(ABS(_effectiveCurrent) / 1000000000, "0.0") & "B",
        ABS(_effectiveCurrent) >= 1000000, FORMAT(ABS(_effectiveCurrent) / 1000000, "0.0") & "M",
        ABS(_effectiveCurrent) >= 1000, FORMAT(ABS(_effectiveCurrent) / 1000, "0.0") & "K",
        FORMAT(ABS(_effectiveCurrent), "#,##0")
    )

VAR _delta = _effectiveCurrent - _benchmark

VAR _deltaFormatted =
    IF(
        _delta >= 0,
        "+$" & SWITCH(
            TRUE(),
            ABS(_delta) >= 1000000000, FORMAT(ABS(_delta) / 1000000000, "0.0") & "B",
            ABS(_delta) >= 1000000, FORMAT(ABS(_delta) / 1000000, "0.0") & "M",
            ABS(_delta) >= 1000, FORMAT(ABS(_delta) / 1000, "0.0") & "K",
            FORMAT(ABS(_delta), "#,##0")
        ),
        "-$" & SWITCH(
            TRUE(),
            ABS(_delta) >= 1000000000, FORMAT(ABS(_delta) / 1000000000, "0.0") & "B",
            ABS(_delta) >= 1000000, FORMAT(ABS(_delta) / 1000000, "0.0") & "M",
            ABS(_delta) >= 1000, FORMAT(ABS(_delta) / 1000, "0.0") & "K",
            FORMAT(ABS(_delta), "#,##0")
        )
    )

VAR _performanceRate = FORMAT(MAX(0, _achievementRatio), "0.0%")

-- Control Variables (Optimized Layout & Gaps)
VAR _containerWidth = "510px"
VAR _containerHeight = "285px"
VAR _containerPadding = "16px"
VAR _cardPadding = "8px" 
VAR _summaryPadding = "16px 16px" -- Increased to make the box taller and fill space
VAR _statusPadding = "4px 8px"
VAR _progressPadding = "2px 6px"
VAR _gridGap = "8px" 
VAR _sectionGap = "16px"  
VAR _headerGap = "14px"   
VAR _progressGap = "16px"

VAR _borderRadius = "6px"
VAR _containerRadius = "10px"

VAR _titleFontSize = "13px"
VAR _subtitleFontSize = "10px"
VAR _statusFontSize = "7px"
VAR _metricFontSize = "13px" 
VAR _varianceFontSize = "13px" 
VAR _labelFontSize = "7px"
VAR _progressLabelFontSize = "10px" 
VAR _progressValueFontSize = "9px" 
VAR _summaryTitleFontSize = "10px" 
VAR _summaryTextFontSize = "9px" 
VAR _benchmarkFontSize = "7px"
VAR _subValueFontSize = "8px"

-- Text Variables
VAR _titleText = "Executive KPI Summary"
VAR _subtitleText = "Current vs Benchmark Overview"
VAR _forecastLabel = "NB Target"
VAR _pipelineLabel = "Projected Revenue"
VAR _actualLabel = "YTD Actual"
VAR _varianceLabel = "Business Gap"
VAR _progressLabel = "Progress to NB Target"
VAR _benchmarkLabel = "NB Target"

-- Status Logic
VAR _performanceLevel =
    SWITCH(
        TRUE(),
        NOT _hasTarget, "no_data",
        _benchmark <= 0 && _effectiveCurrent > 0, "outstanding",
        _benchmark <= 0 && _effectiveCurrent <= 0, "critical",
        _achievementRatio >= 1.15, "outstanding",
        _achievementRatio >= 1.0, "target_met",
        _achievementRatio >= 0.9, "near_target",
        _achievementRatio >= 0.8, "below_target",
        "critical"
    )

-- Theme Colors
VAR _primaryColor = SWITCH(
    _performanceLevel,
    "outstanding", "#7C3AED",
    "target_met", "#059669",
    "near_target", "#0891B2",
    "below_target", "#F59E0B",
    "no_data", "#F59E0B",
    "critical", "#DC2626"
)

VAR _backgroundTint = SWITCH(
    _performanceLevel,
    "outstanding", "#F3F4F6",
    "target_met", "#ECFDF5",
    "near_target", "#F0F9FF",
    "below_target", "#FFFBEB",
    "no_data", "#FFFBEB",
    "critical", "#FEF2F2"
)

VAR _gradientFill = SWITCH(
    _performanceLevel,
    "outstanding", "linear-gradient(135deg, #8B5CF6 0%, #7C3AED 100%)",
    "target_met", "linear-gradient(135deg, #10B981 0%, #059669 100%)",
    "near_target", "linear-gradient(135deg, #06B6D4 0%, #0891B2 100%)",
    "below_target", "linear-gradient(135deg, #FBBF24 0%, #F59E0B 100%)",
    "no_data", "linear-gradient(135deg, #FBBF24 0%, #F59E0B 100%)",
    "critical", "linear-gradient(135deg, #F87171 0%, #DC2626 100%)"
)

VAR _benchmarkLineColor = "#374151"

VAR _statusIcon = SWITCH(
    _performanceLevel,
    "outstanding", "⭐",
    "target_met", "🎯",
    "near_target", "📈",
    "below_target", "⚠️",
    "no_data", "🚨",
    "critical", "🚨"
)

VAR _statusText = SWITCH(
    _performanceLevel,
    "outstanding", "OUTSTANDING",
    "target_met", "TARGET ACHIEVED",
    "near_target", "APPROACHING TARGET",
    "below_target", "BELOW EXPECTATION",
    "no_data", "NO TARGET SET",
    "critical", "REQUIRES ATTENTION"
)

-- Summary Text Variables
VAR _summaryTitle = "📋 Executive Summary"

VAR _gapPercentage = ABS(1 - _achievementRatio)
VAR _gapPercentageFormatted = FORMAT(_gapPercentage, "0.0%")

VAR _summaryTextWithTarget = "Performance is " &
    "<strong style='color: " & _primaryColor & ";'>" & _displayEffectiveCurrent & "</strong>" &
    " vs NB Budget of <strong>" & _displayBenchmark & "</strong>, a " &
    "<strong style='color: " & _primaryColor & ";'>" & _gapPercentageFormatted & "</strong> " &
    IF(_delta >= 0, "above", "below") & " NB Budget."

VAR _summaryTextNoTarget = "No budget target set for comparison. Current actual: " & _displayCurrent &
    IF(_forecast > 0, ", projected: " & _displayForecast & ".", ".")

RETURN
"
<div style='
    width: " & _containerWidth & ";
    height: " & _containerHeight & ";
    padding: " & _containerPadding & ";
    background: linear-gradient(145deg, #FFFFFF 0%, #F9FAFB 100%);
    border-radius: " & _containerRadius & ";
    font-family: Segoe UI, Inter, system-ui, sans-serif;
    color: #111827;
    border: 1px solid #E5E7EB;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    position: relative;
    box-sizing: border-box;
    overflow: hidden;
    display: flex;
    flex-direction: column;
'>

    <div style='
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: " & _headerGap & ";
    '>
        <div>
            <div style='
                font-size: " & _titleFontSize & ";
                font-weight: 700;
                margin-bottom: 2px;
                color: #374151;
            '>" & _titleText & "</div>
            <div style='
                font-size: " & _subtitleFontSize & ";
                color: #6B7280;
                font-weight: 500;
            '>" & _subtitleText & "</div>
        </div>

        <div style='
            background: " & _backgroundTint & ";
            color: " & _primaryColor & ";
            padding: " & _statusPadding & ";
            border-radius: " & _borderRadius & ";
            font-size: " & _statusFontSize & ";
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border: 1px solid " & _primaryColor & "20;
        '>
            " & _statusIcon & " " & _statusText & "
        </div>
    </div>

    <div style='
        display: grid;
        grid-template-columns: 1fr 1fr 1fr 1fr;
        gap: " & _gridGap & ";
        margin-bottom: " & _sectionGap & ";
    '>
        <div style='
            background: #FFFFFF;
            padding: " & _cardPadding & ";
            border-radius: " & _borderRadius & ";
            border: 1px solid #F3F4F6;
            text-align: center;
        '>
            <div style='font-size: " & _labelFontSize & "; color: #6B7280; font-weight: 600; margin-bottom: 4px; text-transform: uppercase;'>" & _forecastLabel & "</div>
            <div style='font-size: " & _metricFontSize & "; font-weight: 800; color: " & IF(_hasTarget, "#374151", "#F59E0B") & "; margin-bottom: 2px;'>" & _displayBenchmark & "</div>
            
            <div style='
                display: flex; 
                justify-content: center; 
                align-items: center; 
                margin-top: 2px;
            '>
                 <div style='text-align: center;'>
                    <div style='font-size: 6px; color: #9CA3AF; font-weight: 600; text-transform: uppercase; line-height: 1;'>" & _selectedYear & " TOTAL</div>
                    <div style='font-size: " & _subValueFontSize & "; color: #6B7280; font-weight: 500; line-height: 1.2;'>" & _displayTotalBudgetYear & "</div>
                 </div>
            </div>
        </div>

        <div style='
            background: #FFFFFF;
            padding: " & _cardPadding & ";
            border-radius: " & _borderRadius & ";
            border: 1px solid #F3F4F6;
            text-align: center;
        '>
            <div style='font-size: " & _labelFontSize & "; color: #6B7280; font-weight: 600; margin-bottom: 4px; text-transform: uppercase;'>" & _pipelineLabel & "</div>
            <div style='font-size: " & _metricFontSize & "; font-weight: 800; color: #374151; margin-bottom: 2px;'>" & _displayForecast & "</div>
            
            <div style='
                display: flex; 
                justify-content: center; 
                align-items: center; 
                margin-top: 2px;
                gap: 6px;
            '>
                 <div style='text-align: center;'>
                    <div style='font-size: 6px; color: #9CA3AF; font-weight: 600; text-transform: uppercase; line-height: 1;'>OPEN</div>
                    <div style='font-size: " & _subValueFontSize & "; color: #6B7280; font-weight: 500; line-height: 1.2;'>" & _displayWtOpen & "</div>
                 </div>
                 <div style='width: 1px; height: 10px; background: #E5E7EB;'></div>
                 <div style='text-align: center;'>
                    <div style='font-size: 6px; color: #9CA3AF; font-weight: 600; text-transform: uppercase; line-height: 1;'>WON</div>
                    <div style='font-size: " & _subValueFontSize & "; color: #6B7280; font-weight: 500; line-height: 1.2;'>" & _displayCrmWon & "</div>
                 </div>
            </div>
        </div>

        <div style='
            background: #FFFFFF;
            padding: " & _cardPadding & ";
            border-radius: " & _borderRadius & ";
            border: 1px solid #F3F4F6;
            text-align: center;
        '>
            <div style='font-size: " & _labelFontSize & "; color: #6B7280; font-weight: 600; margin-bottom: 4px; text-transform: uppercase;'>" & _actualLabel & "</div>
            <div style='font-size: " & _metricFontSize & "; font-weight: 800; color: " & _primaryColor & "; margin-bottom: 2px;'>" & _displayCurrent & "</div>
            
            <div style='
                display: flex; 
                justify-content: center; 
                align-items: center; 
                margin-top: 2px;
            '>
                 <div style='text-align: center;'>
                    <div style='font-size: 6px; color: #9CA3AF; font-weight: 600; text-transform: uppercase; line-height: 1;'>FINANCE</div>
                    <div style='font-size: " & _subValueFontSize & "; color: #6B7280; font-weight: 500; line-height: 1.2;'>PERFORMANCE</div>
                 </div>
            </div>
        </div>

        <div style='
            background: " & _backgroundTint & ";
            padding: " & _cardPadding & ";
            border-radius: " & _borderRadius & ";
            border: 1px solid " & _primaryColor & "20;
            text-align: center;
        '>
            <div style='font-size: " & _labelFontSize & "; color: " & _primaryColor & "; font-weight: 600; margin-bottom: 4px; text-transform: uppercase;'>" & _varianceLabel & "</div>
            <div style='font-size: " & _varianceFontSize & "; font-weight: 800; color: " & _primaryColor & "; margin-bottom: 2px;'>" & IF(_hasTarget, _deltaFormatted, "—") & "</div>
        </div>
    </div>

    <div style='margin-bottom: " & _progressGap & ";'>
        <div style='
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 6px;
        '>
            <span style='font-size: " & _progressLabelFontSize & "; font-weight: 600; color: #334155;'>" & _progressLabel & "</span>
            <span style='
                font-size: " & _progressValueFontSize & ";
                font-weight: 700;
                color: " & _primaryColor & ";
                background: " & _backgroundTint & ";
                padding: " & _progressPadding & ";
                border-radius: " & _borderRadius & ";
                border: 1px solid " & _primaryColor & "20;
            '>" & IF(_hasTarget, FORMAT(_achievementRatio, "0.0%"), "—") & "</span>
        </div>

        <div style='
            width: 100%;
            height: 6px;
            background: #F1F5F9;
            border-radius: 3px;
            position: relative;
            overflow: hidden;
        '>
            <div style='
                width: " & _currentWidthCSS & ";
                height: 100%;
                background: " & _gradientFill & ";
                border-radius: 3px;
                transition: width 1.2s ease-out;
            '></div>

            <div style='
                position: absolute;
                left: " & _benchmarkWidthCSS & ";
                top: -1px;
                bottom: -1px;
                width: 2px;
                background: " & _benchmarkLineColor & ";
                border-radius: 2px;
                box-shadow: 0 0 4px rgba(55, 65, 81, 0.4);
            '></div>
            <div style='
                position: absolute;
                left: " & _benchmarkWidthCSS & ";
                top: -20px;
                transform: translateX(-50%);
                background: " & _benchmarkLineColor & ";
                color: white;
                padding: 2px 6px;
                border-radius: 4px;
                font-size: " & _benchmarkFontSize & ";
                font-weight: 600;
                white-space: nowrap;
            '>" & _benchmarkLabel & "</div>
        </div>
    </div>

    <div style='
        background: linear-gradient(135deg, " & _backgroundTint & " 0%, rgba(255,255,255,0.8) 100%);
        border: 1px solid " & _primaryColor & "25;
        border-radius: " & _borderRadius & ";
        padding: " & _summaryPadding & ";
        margin-top: auto;
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-height: 56px;
    '>
        <div style='font-size: " & _summaryTitleFontSize & "; font-weight: 600; color: #334155; margin-bottom: 4px;'>" & _summaryTitle & "</div>
        <div style='font-size: " & _summaryTextFontSize & "; color: #4B5563; line-height: 1.4;'>" &
            IF(_hasTarget, _summaryTextWithTarget, _summaryTextNoTarget) &
        "</div>
    </div>

</div>
"